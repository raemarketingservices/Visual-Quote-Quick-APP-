<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="120dp"
    android:viewportWidth="200"
    android:viewportHeight="120">

    <!-- Speed streaks on left -->
    <path
        android:pathData="M15,32 L60,32"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="15"
                android:startY="32"
                android:endX="60"
                android:endY="32"
                android:type="linear">
                <item android:color="#330083CA" android:offset="0.0" />
                <item android:color="#CC0083CA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M5,42 L65,42"
        android:strokeWidth="4.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="5"
                android:startY="42"
                android:endX="65"
                android:endY="42"
                android:type="linear">
                <item android:color="#220083CA" android:offset="0.0" />
                <item android:color="#FF0083CA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M12,52 L62,52"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="12"
                android:startY="52"
                android:endX="62"
                android:endY="52"
                android:type="linear">
                <item android:color="#330066CC" android:offset="0.0" />
                <item android:color="#DD0066CC" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M20,62 L55,62"
        android:strokeWidth="3.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="62"
                android:endX="55"
                android:endY="62"
                android:type="linear">
                <item android:color="#220052CC" android:offset="0.0" />
                <item android:color="#BB0052CC" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- First Q Outer Ring -->
    <path
        android:pathData="M85,16 C68,16 54,30 54,47 C54,64 68,78 85,78 C94,78 102,74 107,67 L107,72 L120,83 L130,83 L114,69 C116,62 116,32 85,16 Z M85,30 C94,30 102,38 102,47 C102,56 94,64 85,64 C76,64 68,56 68,47 C68,38 76,30 85,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="16"
                android:endX="120"
                android:endY="83"
                android:type="linear">
                <item android:color="#00A3FF" android:offset="0.0" />
                <item android:color="#0066D6" android:offset="0.6" />
                <item android:color="#0047AB" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Second Q Outer Ring -->
    <path
        android:pathData="M130,16 C113,16 99,30 99,47 C99,64 113,78 130,78 C139,78 147,74 152,67 L152,72 L165,83 L175,83 L159,69 C161,62 161,32 130,16 Z M130,30 C139,30 147,38 147,47 C147,56 139,64 130,64 C121,64 113,56 113,47 C113,38 121,30 130,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="99"
                android:startY="16"
                android:endX="175"
                android:endY="83"
                android:type="linear">
                <item android:color="#0066D6" android:offset="0.0" />
                <item android:color="#0047AB" android:offset="0.5" />
                <item android:color="#0B2341" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Red underline left -->
    <path
        android:pathData="M22,112 L50,112"
        android:strokeColor="#DC2626"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Red underline right -->
    <path
        android:pathData="M150,112 L178,112"
        android:strokeColor="#DC2626"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
</vector>
